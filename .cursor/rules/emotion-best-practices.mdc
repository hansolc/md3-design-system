## 6. Render Delegation Pattern (asChild)

### Using Radix UI Slot

A pattern to merge component styles into child elements. More explicit and predictable than polymorphic pattern.

**✅ Best Practice (with Props Type Separation):**

```typescript
import { forwardRef, useMemo, type CSSProperties } from 'react'
import { Slot, Slottable } from '@radix-ui/react-slot'
import { css, type SerializedStyles } from '@emotion/react'

// 1. Separate component behavior and styling props
interface _FlexProps extends React.HTMLAttributes<HTMLDivElement> {
  asChild?: boolean
  children?: React.ReactNode
}

interface FlexStylesProps {
  direction?: CSSProperties['flexDirection']
  gap?: CSSProperties['gap']
  alignItems?: CSSProperties['alignItems']
}

type FlexProps = _FlexProps & FlexStylesProps

// 2. Define style function with explicit destructuring
const createFlexStyles = ({
  direction,
  gap,
  alignItems,
}: FlexStylesProps): SerializedStyles =>
  css({
    display: 'flex',
    flexDirection: direction,
    gap: gap,
    alignItems: alignItems,
  })

const Flex = forwardRef<HTMLDivElement, FlexProps>(
  ({ asChild = false, children, direction, gap, alignItems, ...restProps }, ref) => {
    // 3. Memoize styles
    const flexStyles = useMemo(
      () => createFlexStyles({ direction, gap, alignItems }),
      [direction, gap, alignItems]
    )

    // 4. Render delegation with Slottable
    const Comp = asChild ? Slot : 'div'

    return (
      <Comp ref={ref} css={flexStyles} {...restProps}>
        <Slottable>{children}</Slottable>
      </Comp>
    )
  }
)

Flex.displayName = 'Flex'

export default Flex
```

### Usage Examples

```typescript
// Normal usage - renders as div
<Flex direction="row" gap="16px">
  <div>Item 1</div>
  <div>Item 2</div>
</Flex>

// asChild usage - Flex styles merge into header
<Flex asChild gap="16px" alignItems="center">
  <header>
    <h1>Title</h1>
    <nav>Menu</nav>
  </header>
</Flex>
```

### Benefits:

- Eliminates if-else branching
- Slottable correctly handles children
- More explicit and predictable behavior
- Consistent with Radix UI ecosystem

