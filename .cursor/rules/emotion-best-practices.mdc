## 5. Theme Usage

### Extend Theme Type

Extend Theme type in `emotion.d.ts` for autocomplete and type checking.

**theme.ts:**

```typescript
import { textTokens } from '@/components/Text/tokens'
import { light, dark } from './color'

export type ThemeMode = 'light' | 'dark'

// 1. Define theme object first
export const createTheme = (mode: ThemeMode) => ({
  text: textTokens,
  colors: mode === 'light' ? light : dark,
  mode,
})

// 2. Extract type using typeof
export type AppTheme = ReturnType<typeof createTheme>
```

**emotion.d.ts:**

```typescript
import '@emotion/react'
import type { AppTheme } from './theme'

declare module '@emotion/react' {
  // Extend Emotion's Theme with AppTheme
  export interface Theme extends AppTheme {}
}
```

### Theme Access Methods

**Method 1: Function in css prop (Recommended)**

```typescript
import { css, type Theme } from '@emotion/react'

const getTextStyle = (theme: Theme, variant: string) => {
  const token = theme.text[variant].lg
  return css({
    fontSize: `${token.fontSize}px`,
    fontWeight: token.fontWeight,
  })
}

const Text = ({ variant = 'body' }) => {
  return (
    <span css={(theme: Theme) => getTextStyle(theme, variant)}>
      Hello
    </span>
  )
}
```

**Method 2: useTheme hook**

```typescript
import { useTheme } from '@emotion/react'
import type { Theme } from '@emotion/react'

const Text = () => {
  const theme = useTheme() as Theme

  const styles = css({
    color: theme.colors.primary,
  })

  return <span css={styles}>Hello</span>
}
```

